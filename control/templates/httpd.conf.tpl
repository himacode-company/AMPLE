# =====================================================================
#  ample — Apache configuration
#  GENERATED by AMPLE on every start — changes here will be overwritten.
#  To change it permanently edit control/templates/httpd.conf.tpl,
#  use the control panel, or add your own .conf in apache/conf/vhosts/.
# =====================================================================

Define AMPLE_ROOT "{{ROOT}}"
ServerRoot "{{APACHE}}"
Listen 127.0.0.1:{{HTTP_PORT}}
ServerName localhost:{{HTTP_PORT}}
ServerAdmin admin@localhost
ServerSignature Off
ServerTokens Prod
PidFile "{{RUN}}/apache.pid"

# --- Modules (only what a local PHP dev server needs) -----------------
LoadModule access_compat_module modules/mod_access_compat.so
LoadModule alias_module         modules/mod_alias.so
LoadModule auth_basic_module    modules/mod_auth_basic.so
LoadModule authn_core_module    modules/mod_authn_core.so
LoadModule authn_file_module    modules/mod_authn_file.so
LoadModule authz_core_module    modules/mod_authz_core.so
LoadModule authz_host_module    modules/mod_authz_host.so
LoadModule authz_user_module    modules/mod_authz_user.so
LoadModule autoindex_module     modules/mod_autoindex.so
LoadModule deflate_module       modules/mod_deflate.so
LoadModule dir_module           modules/mod_dir.so
LoadModule env_module           modules/mod_env.so
LoadModule expires_module       modules/mod_expires.so
LoadModule filter_module        modules/mod_filter.so
LoadModule headers_module       modules/mod_headers.so
LoadModule log_config_module    modules/mod_log_config.so
LoadModule mime_module          modules/mod_mime.so
LoadModule proxy_module         modules/mod_proxy.so
LoadModule proxy_http_module    modules/mod_proxy_http.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so
LoadModule ssl_module           modules/mod_ssl.so
LoadModule substitute_module    modules/mod_substitute.so
LoadModule vhost_alias_module   modules/mod_vhost_alias.so
# mod_ssl is always loaded (for "ample https on"); without a session cache it warns
# AH01873 on every start, so it is configured here even while HTTPS is off.
SSLSessionCache "shmcb:{{RUN}}/ssl_scache(512000)"
LoadModule rewrite_module       modules/mod_rewrite.so
LoadModule setenvif_module      modules/mod_setenvif.so

# --- PHP {{PHP_VERSION}} ------------------------------------------------
LoadFile "{{PHP_DIR}}/{{PHP_TS_DLL}}"
LoadModule php_module "{{PHP_DIR}}/{{PHP_APACHE_DLL}}"
PHPIniDir "{{PHP_DIR}}"
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
<FilesMatch "\.phps$">
    SetHandler application/x-httpd-php-source
</FilesMatch>

# --- Performance (Windows MPM) ----------------------------------------
ThreadsPerChild 150
MaxConnectionsPerChild 0
AcceptFilter http none
AcceptFilter https none
EnableSendfile Off
EnableMMAP Off
Timeout 300
KeepAlive On
MaxKeepAliveRequests 200
KeepAliveTimeout 5

# --- Logging: human readable ------------------------------------------
# Error log line:  [2026-11-13 14:02:11] [php:error] [pid 123] [client 127.0.0.1] AH01071: message
# "\ " keeps a field together; a field with no value (e.g. no client) is dropped.
ErrorLogFormat "[%{c}t] [%-m:%l] [pid %P] [client\ %a] %E: %M"
ErrorLog "{{LOGS}}/apache/error.log"
LogLevel {{APACHE_LOG_LEVEL}}

# Access log line: 2026-11-13 14:02:11 | 200 | GET /index.php | 12 ms | 3120 B | 127.0.0.1 | Mozilla/5.0 ...
LogFormat "%{%Y-%m-%d %H:%M:%S}t | %>s | %m %U%q | %{ms}T ms | %B B | %a | %{User-Agent}i" ample
CustomLog "{{LOGS}}/apache/access.log" ample

# --- Security defaults -------------------------------------------------
<Directory />
    AllowOverride None
    Require all denied
</Directory>
<Files ".ht*">
    Require all denied
</Files>
Header always set X-Content-Type-Options "nosniff"

# --- Your sites: htdocs/ ------------------------------------------------
DocumentRoot "{{HTDOCS}}"
<Directory "{{HTDOCS}}">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require local
</Directory>
DirectoryIndex index.php index.html index.htm

# --- ample tools --------------------------------------------------------
Alias /phpmyadmin "{{PMA}}"
<Directory "{{PMA}}">
    AllowOverride None
    Require local
</Directory>

# AMPLE additions to phpMyAdmin (sidebar, top bar and page design; sidebar folders; home
# page cards), added to its pages here so that no
# phpMyAdmin file is ever modified (they survive phpMyAdmin updates). HTML pages only:
# its AJAX replies are JSON and stay untouched. Needs phpMyAdmin's own gzip off (OBGzip).
Alias /ample-pma "{{ROOT}}/control/pma"
<Directory "{{ROOT}}/control/pma">
    AllowOverride None
    Require local
    # Browsers must ask before reusing a cached copy (a cheap 304 when unchanged), so a
    # changed AMPLE file is used at once, even when phpMyAdmin navigates with AJAX.
    Header set Cache-Control "no-cache"
</Directory>
# "ample design phpmyadmin original" turns the three lines below into comments (#): phpMyAdmin
# then looks exactly as its makers ship it.
<Location "/phpmyadmin/">
    {{PMA_AMPLE}}AddOutputFilterByType SUBSTITUTE text/html
    {{PMA_AMPLE}}SubstituteMaxLineLength 10m
    # The first piece sets light/dark BEFORE the page is drawn (no light flash): the choice saved
    # by the ◐ button (shared with the AMPLE dashboard), else Windows' own setting.
    {{PMA_AMPLE}}Substitute "s|</head>|<script>try{var t=localStorage.getItem('ample-theme');if(t!=='dark'&&t!=='light')t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t)}catch(e){}</script><link rel='stylesheet' href='/ample-pma/ample-nav.css'><link rel='stylesheet' href='/ample-pma/ample-top.css'><link rel='stylesheet' href='/ample-pma/ample-page.css'><link rel='stylesheet' href='/ample-pma/ample-console.css'><link rel='stylesheet' href='/ample-pma/ample-modal.css'><link rel='stylesheet' href='/ample-pma/ample-designer.css'><script src='/ample-pma/ample-nav.js' defer></script><script src='/ample-pma/ample-page.js' data-port='{{MYSQL_PORT}}' data-password='{{MYSQL_HAS_PASSWORD}}' defer></script><script src='/ample-pma/ample-designer.js' defer></script></head>|n"
</Location>

Alias /ample "{{DASHBOARD}}"
<Directory "{{DASHBOARD}}">
    AllowOverride None
    Require local
</Directory>

# Mailpit (emails sent by PHP). upgrade=websocket keeps the inbox live.
<Location "/mailpit/">
    # Keep the browser's Host (e.g. localhost): Mailpit checks it against the Origin
    # header and blocks the request ("[cors] blocking request") when they differ.
    ProxyPreserveHost On
    ProxyPass "http://127.0.0.1:{{MAILPIT_PORT}}/mailpit/" upgrade=websocket
    ProxyPassReverse "http://127.0.0.1:{{MAILPIT_PORT}}/mailpit/"
    Require local
    # Mailpit's page asks for a login (DNS-rebinding protection of its own port); Apache sends
    # it for you here, so http://localhost/mailpit/ opens without typing anything.
    RequestHeader set Authorization "Basic {{MAILPIT_AUTH}}"
    # AMPLE look (control/pma/ample-mailpit.css / .js), added here so no Mailpit file changes:
    #  - ask Mailpit for uncompressed pages, so Apache can add our files (Apache still
    #    compresses what it sends to the browser)
    #  - HTML pages only (scripts, images and the live websocket are untouched)
    #  - our stylesheet before </head>
    #  - our script right BEFORE Mailpit's, with the SAME one-time nonce copied from Mailpit's
    #    tag ($2): Mailpit's security policy only runs scripts carrying it, and stays unchanged
    # "ample design mailpit original" turns these four lines into comments (#).
    {{MAILPIT_AMPLE}}RequestHeader unset Accept-Encoding
    {{MAILPIT_AMPLE}}AddOutputFilterByType SUBSTITUTE text/html
    {{MAILPIT_AMPLE}}Substitute "s|</head>|<link rel='stylesheet' href='/ample-pma/ample-mailpit.css'></head>|n"
    {{MAILPIT_AMPLE}}Substitute "s|<script src=\"([^\"]+)\" nonce=\"([^\"]+)\"></script>|<script src=\"/ample-pma/ample-mailpit.js\" nonce=\"$2\"></script><script src=\"$1\" nonce=\"$2\"></script>|"
</Location>
RedirectMatch 301 "^/mailpit$" "/mailpit/"

# --- MIME / compression -------------------------------------------------
TypesConfig conf/mime.types
AddType application/x-compress .Z
AddType application/x-gzip .gz .tgz
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml

IndexOptions FancyIndexing HTMLTable VersionSort NameWidth=* FoldersFirst Charset=UTF-8
AddDefaultCharset UTF-8

# --- Unknown host names are refused (DNS-rebinding protection) ------------
# Apache serves a request whose host name matches no site with the FIRST site of the port. A
# malicious website can point its own name at 127.0.0.1 ("DNS rebinding") and make your
# browser use phpMyAdmin, the dashboard or Mailpit for it. So the first site is this one, which
# refuses everything: only localhost, 127.0.0.1, NAME.localhost and your own virtual hosts work.
<VirtualHost *:{{HTTP_PORT}}>
    ServerName unknown-host.ample.invalid
    <Location "/">
        Require all denied
    </Location>
    ErrorDocument 403 "AMPLE refused this request: the host name is not one of yours. Open http://localhost/ or http://NAME.localhost/ instead."
</VirtualHost>

# --- Your own additions (virtual hosts, etc.) ---------------------------
# Put one .conf file per virtual host in apache/conf/vhosts/ (kept across upgrades).
# Loaded BEFORE the generated sites, so a host you define yourself wins.
IncludeOptional "{{VHOSTS}}/*.conf"

# --- One site per htdocs folder: http://NAME.localhost (generated) ----------
Include "{{SITES_CONF}}"

# --- "ample share": the private door for a public link (generated) ---------
# Empty unless a site is being shared. Written by control/core/share.js: 127.0.0.1 only,
# serves that ONE site, and refuses phpMyAdmin, the dashboard and Mailpit.
IncludeOptional "{{SHARE_CONF}}"
