; =====================================================================
;  ample — PHP {{PHP_VERSION}} configuration (development profile)
;  GENERATED by AMPLE on every start — changes here will be overwritten.
;  To change it permanently edit control/templates/php.ini.tpl or use the control panel.
; =====================================================================

[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1
expose_php = Off

; --- Limits (generous for local development) --------------------------
; Values from ample.json "phpIni" replace these lines (marked "; ← ample.json").
max_execution_time = 30
max_input_time = 120
max_input_vars = 5000
memory_limit = 128M
post_max_size = 8M
upload_max_filesize = 2M
max_file_uploads = 50
file_uploads = On
default_socket_timeout = 60

; --- Errors: show everything, log everything --------------------------
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{LOGS}}/php/error.log"
html_errors = On
ignore_repeated_errors = Off
report_memleaks = On
zend.exception_ignore_args = Off
zend.exception_string_param_max_len = 64

; --- Paths ---------------------------------------------------------------
include_path = ".;{{PHP_DIR}}/pear"
extension_dir = "{{PHP_DIR}}/ext"
upload_tmp_dir = "{{TMP}}/uploads"
sys_temp_dir = "{{TMP}}"
user_dir =
enable_dl = Off
doc_root =

; --- Data handling --------------------------------------------------------
variables_order = "GPCS"
request_order = "GP"
register_argc_argv = Off
auto_globals_jit = On
default_mimetype = "text/html"
default_charset = "UTF-8"
allow_url_fopen = On
allow_url_include = Off

; --- Extensions (auto-detected: only ones that load on this machine) ----
{{PHP_EXTENSIONS}}

[Date]
date.timezone = "{{TIMEZONE}}"

[Session]
session.save_handler = files
session.save_path = "{{TMP}}/sessions"
session.use_strict_mode = 1
session.use_cookies = 1
session.use_only_cookies = 1
session.name = PHPSESSID
session.cookie_httponly = 1
session.cookie_samesite = "Lax"
; >= phpMyAdmin LoginCookieValidity (86400), otherwise phpMyAdmin shows a warning.
session.gc_maxlifetime = 86400

[mail function]
; mail() sends to AMPLE's Mailpit: nothing leaves your PC.
; Read the emails at http://localhost/mailpit/
SMTP = 127.0.0.1
smtp_port = {{SMTP_PORT}}
sendmail_from = "ample@localhost"
mail.add_x_header = Off

[curl]
curl.cainfo = "{{CACERT}}"

[openssl]
openssl.cafile = "{{CACERT}}"

[mysqli]
mysqli.default_host = "127.0.0.1"
mysqli.default_port = {{MYSQL_PORT}}
mysqli.allow_persistent = On

[mbstring]
mbstring.language = neutral

[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 192
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
; Development: pick up file changes immediately.
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
; No opcache.file_cache: it mirrors full paths under tmp/ and exceeds Windows' 260-char path limit.

[Assertion]
zend.assertions = 1

[xdebug]
; ample xdebug on|off
{{PHP_XDEBUG}}

; --- Your settings (ample.json "phpIni") not already listed above ----------
{{PHP_USER_INI}}
