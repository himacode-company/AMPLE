# =====================================================================
#  ample — MariaDB {{MARIADB_VERSION}} configuration
#  GENERATED by AMPLE on every start — changes here will be overwritten.
#  To change it permanently edit control/templates/my.ini.tpl or use the control panel.
# =====================================================================

[client]
port = {{MYSQL_PORT}}
host = 127.0.0.1
default-character-set = utf8mb4

[mysqld]
basedir = "{{MARIADB}}"
datadir = "{{MYSQL_DATA}}"
tmpdir  = "{{TMP}}"
port = {{MYSQL_PORT}}
bind-address = 127.0.0.1
skip-name-resolve
pid-file = "{{RUN}}/mariadb.pid"

# --- Character set --------------------------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# --- Logs (readable, separate files) --------------------------------------
log-error = "{{LOGS}}/mariadb/error.log"
log_warnings = 2
slow_query_log = 1
slow_query_log_file = "{{LOGS}}/mariadb/slow.log"
long_query_time = 2
log_queries_not_using_indexes = 0
general_log = {{MYSQL_GENERAL_LOG}}
general_log_file = "{{LOGS}}/mariadb/general.log"
log_output = FILE

# --- Memory / performance (sized for a dev machine) -----------------------
max_connections = 200
max_allowed_packet = 512M
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2
table_open_cache = 2000
tmp_table_size = 64M
max_heap_table_size = 64M
sort_buffer_size = 2M

# --- SQL behavior -----------------------------------------------------------
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
default_storage_engine = InnoDB
lower_case_table_names = 1
explicit_defaults_for_timestamp = 1

[mysqldump]
max_allowed_packet = 512M
quick

[mysql]
default-character-set = utf8mb4
